@{
    ViewData["Title"] = "About Us";
}

<!-- Page Header -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">ABOUT GIFT OF THE GIVERS</h1>
        <p class="lead">Compassion in Action • Relief Where It Matters</p>
    </div>
</section>

<!-- Who We Are Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-4">
                    <h2 class="display-5 fw-bold mb-2">Who We Are</h2>
                    <div class="section-divider mx-auto" style="width: 100px; height: 3px; background: #0d6efd;"></div>
                </div>

                <div class="row mt-5">
                    <div class="col-md-6 mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bi bi-globe text-primary" style="font-size: 2rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Global Humanitarian Organization</h5>
                                <p class="text-muted">
                                    Gift of the Givers is one of the largest disaster relief organizations, 
                                    operating across multiple continents to provide critical aid where it's needed most.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bi bi-heart-fill text-danger" style="font-size: 2rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Founded on Compassion</h5>
                                <p class="text-muted">
                                    Since our inception, we've been committed to serving humanity with dignity, 
                                    respect, and unwavering dedication to those in need.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bi bi-people-fill text-success" style="font-size: 2rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Non-Discriminatory Service</h5>
                                <p class="text-muted">
                                    We provide assistance to all communities regardless of race, religion, 
                                    nationality, or political affiliation.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bi bi-lightning-fill text-warning" style="font-size: 2rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Rapid Response</h5>
                                <p class="text-muted">
                                    Our teams are trained and ready to respond within hours to natural disasters 
                                    and humanitarian crises around the world.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <!-- Mission -->
            <div class="col-lg-6 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-compass text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="h3 text-center fw-bold mb-4">Mission</h2>
                        <div class="section-divider mx-auto mb-4" style="width: 60px; height: 3px; background: #0d6efd;"></div>
                        <p class="lead text-center mb-3">
                            To provide immediate relief and long-term sustainable solutions to communities 
                            affected by natural disasters, poverty, and conflict.
                        </p>
                        <p class="text-muted">
                            We are committed to alleviating human suffering through compassionate action, 
                            delivering food, water, shelter, medical care, and hope to those who need it most.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Vision -->
            <div class="col-lg-6 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-eye text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="h3 text-center fw-bold mb-4">Vision</h2>
                        <div class="section-divider mx-auto mb-4" style="width: 60px; height: 3px; background: #198754;"></div>
                        <p class="lead text-center mb-3">
                            A world where no community suffers alone, and humanitarian aid reaches 
                            every person in need, regardless of circumstance.
                        </p>
                        <p class="text-muted">
                            We envision strengthened communities that are resilient, self-sufficient, 
                            and empowered to overcome challenges through collective support and sustainable development.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Approach Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-2">Our Approach</h2>
                    <div class="section-divider mx-auto" style="width: 100px; height: 3px; background: #0d6efd;"></div>
                </div>

                <div class="row g-4">
                    <div class="col-md-3 text-center">
                        <div class="approach-step">
                            <div class="step-number bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">1</div>
                            <h5 class="fw-bold mb-3">Assess</h5>
                            <p class="text-muted">
                                Rapid needs assessment to understand the scope and urgency of the crisis
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="approach-step">
                            <div class="step-number bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">2</div>
                            <h5 class="fw-bold mb-3">Mobilize</h5>
                            <p class="text-muted">
                                Deploy resources, volunteers, and supplies to the affected area
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="approach-step">
                            <div class="step-number bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">3</div>
                            <h5 class="fw-bold mb-3">Deliver</h5>
                            <p class="text-muted">
                                Provide immediate relief including food, water, shelter, and medical care
                            </p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="approach-step">
                            <div class="step-number bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">4</div>
                            <h5 class="fw-bold mb-3">Rebuild</h5>
                            <p class="text-muted">
                                Support long-term recovery and community resilience
                            </p>
                        </div>
                    </div>
                </div>

                <div class="mt-5 p-4 bg-light rounded">
                    <h4 class="fw-bold mb-3">Core Principles</h4>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Humanity:</strong> <span class="text-muted">Serving all people with dignity</span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Neutrality:</strong> <span class="text-muted">Impartial assistance</span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong>Accountability:</strong> <span class="text-muted">Transparent operations</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Technology Matters Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-3">Why Technology Matters</h2>
                    <div class="section-divider mx-auto" style="width: 100px; height: 3px; background: white;"></div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-clock-history" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Real-Time Tracking</h4>
                            <p>
                                Monitor relief operations in real-time, ensuring resources reach 
                                the right people at the right time.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-graph-up-arrow" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Data-Driven Decisions</h4>
                            <p>
                                Use analytics to optimize resource allocation and maximize 
                                the impact of every donation.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-shield-check" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Transparency</h4>
                            <p>
                                Donors can track their contributions and see the direct 
                                impact of their support on communities.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-people" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Volunteer Coordination</h4>
                            <p>
                                Efficiently manage thousands of volunteers, matching 
                                skills with needs across multiple projects.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-speedometer" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Faster Response</h4>
                            <p>
                                Reduce response time from days to hours through 
                                automated alerts and streamlined workflows.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-4">
                            <i class="bi bi-list-check" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold my-3">Project Management</h4>
                            <p>
                                Coordinate complex relief operations with multiple teams, 
                                resources, and stakeholders efficiently.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Impact Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-2">Our Impact</h2>
                    <div class="section-divider mx-auto mb-4" style="width: 100px; height: 3px; background: #0d6efd;"></div>
                    <p class="lead text-muted">Making a measurable difference in communities worldwide</p>
                </div>

                <!-- Statistics -->
                <div class="row g-4 mb-5">
                    <div class="col-md-3 text-center">
                        <div class="impact-card p-4 bg-white rounded shadow-sm h-100">
                            <i class="bi bi-check2-circle text-primary" style="font-size: 2.5rem;"></i>
                            <h2 class="display-4 fw-bold text-primary mt-3 mb-2">1000+</h2>
                            <p class="text-muted mb-0">Projects Completed</p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="impact-card p-4 bg-white rounded shadow-sm h-100">
                            <i class="bi bi-heart-fill text-danger" style="font-size: 2.5rem;"></i>
                            <h2 class="display-4 fw-bold text-primary mt-3 mb-2">50,000+</h2>
                            <p class="text-muted mb-0">Lives Impacted</p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="impact-card p-4 bg-white rounded shadow-sm h-100">
                            <i class="bi bi-geo-alt-fill text-success" style="font-size: 2.5rem;"></i>
                            <h2 class="display-4 fw-bold text-primary mt-3 mb-2">25+</h2>
                            <p class="text-muted mb-0">Countries Served</p>
                        </div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="impact-card p-4 bg-white rounded shadow-sm h-100">
                            <i class="bi bi-people-fill text-info" style="font-size: 2.5rem;"></i>
                            <h2 class="display-4 fw-bold text-primary mt-3 mb-2">5000+</h2>
                            <p class="text-muted mb-0">Active Volunteers</p>
                        </div>
                    </div>
                </div>

                <!-- Impact Stories -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-droplet-fill text-primary" style="font-size: 2rem;"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">Clean Water Access</h5>
                                        <small class="text-muted">5,000 families served</small>
                                    </div>
                                </div>
                                <p class="text-muted">
                                    Provided sustainable clean water solutions to communities, 
                                    reducing waterborne diseases by 80%.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-success bg-opacity-10 p-3 rounded me-3">
                                        <i class="bi bi-house-fill text-success" style="font-size: 2rem;"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">Shelter Provision</h5>
                                        <small class="text-muted">2,000+ homes rebuilt</small>
                                    </div>
                                </div>
                                <p class="text-muted">
                                    Reconstructed homes for families displaced by natural disasters, 
                                    providing safe and dignified living spaces.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How We Respond Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="text-center mb-5">
                    <h2 class="display-5 fw-bold mb-2">How We Respond</h2>
                    <div class="section-divider mx-auto mb-4" style="width: 100px; height: 3px; background: #0d6efd;"></div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <h4 class="fw-bold mb-3">
                                    <i class="bi bi-lightning-fill text-warning me-2"></i>
                                    Emergency Response
                                </h4>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Deploy within 24-48 hours of disaster
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Pre-positioned emergency supplies
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Trained rapid response teams
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        24/7 emergency coordination center
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <h4 class="fw-bold mb-3">
                                    <i class="bi bi-arrow-repeat text-primary me-2"></i>
                                    Long-Term Recovery
                                </h4>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Community rebuilding programs
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Livelihood restoration support
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Education and skills training
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        Sustainable development initiatives
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="py-5" style="background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-navy) 100%);">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center text-white">
                <h2 class="display-4 fw-bold mb-4">Support Our Mission</h2>
                <p class="lead mb-5">
                    Join us in making a difference. Your support helps us deliver 
                    relief where it's needed most and restore hope to communities in crisis.
                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-action="Donate" class="btn btn-light btn-lg px-5 py-3 shadow">
                        <i class="bi bi-heart-fill me-2"></i> Make a Donation
                    </a>
                    <a asp-action="Volunteer" class="btn btn-outline-light btn-lg px-5 py-3 shadow">
                        <i class="bi bi-people-fill me-2"></i> Become a Volunteer
                    </a>
                    <a asp-action="Contact" class="btn btn-outline-light btn-lg px-5 py-3 shadow">
                        <i class="bi bi-envelope-fill me-2"></i> Get in Touch
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .section-divider {
        transition: width 0.3s ease;
    }

    .impact-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .impact-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .approach-step .step-number {
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .approach-step:hover .step-number {
        transform: scale(1.1);
        background-color: #0a58ca !important;
    }
</style>
