@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section with Video Background -->
<section class="hero-section position-relative overflow-hidden" style="min-height: 80vh; background: linear-gradient(135deg, #0066cc 0%, #004999 100%);">
    <div class="hero-overlay position-absolute w-100 h-100" style="background: rgba(0, 0, 0, 0.3); z-index: 1;"></div>

    <!-- Optional: Video Background (uncomment when you have video) -->
    <!-- <video autoplay muted loop class="position-absolute w-100 h-100" style="object-fit: cover; z-index: 0;">
        <source src="~/videos/hero-video.mp4" type="video/mp4">
    </video> -->

    <div class="container position-relative text-center text-white d-flex flex-column justify-content-center" style="min-height: 80vh; z-index: 2;">
        <!-- Logo/Compass Icon -->
        <div class="mb-4">
            <i class="bi bi-compass" style="font-size: 5rem; opacity: 0.9;"></i>
        </div>

        <!-- Main Title -->
        <h1 class="display-2 fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
            GIFT OF THE GIVERS
        </h1>
        <h2 class="display-5 mb-4" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
            Relief Management System
        </h2>

        <!-- Subtitle -->
        <p class="lead mb-5 fs-4" style="max-width: 700px; margin: 0 auto;">
            Help deliver relief where it matters.
        </p>

        <!-- CTA Buttons -->
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-action="Donate" class="btn btn-light btn-lg px-5 py-3 shadow">
                <i class="bi bi-heart-fill me-2"></i> DONATE
            </a>
            <a asp-action="Volunteer" class="btn btn-outline-light btn-lg px-5 py-3 shadow">
                <i class="bi bi-people-fill me-2"></i> VOLUNTEER
            </a>
        </div>
    </div>

    <!-- Scroll Down Indicator -->
    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4" style="z-index: 2;">
        <i class="bi bi-chevron-down text-white" style="font-size: 2rem; animation: bounce 2s infinite;"></i>
    </div>
</section>

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<!-- Our Mission Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold mb-4">OUR MISSION</h2>
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-4 fs-3 text-primary">
                <span class="fw-bold">Compassion</span>
                <span class="text-muted">•</span>
                <span class="fw-bold">Action</span>
                <span class="text-muted">•</span>
                <span class="fw-bold">Impact</span>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="lead mb-4">
                    We are dedicated to providing humanitarian aid and disaster relief 
                    to communities in need. Through compassionate action, we create lasting 
                    impact by delivering hope, food, shelter, and medical care to those 
                    affected by natural disasters and poverty.
                </p>
                <a asp-action="About" class="btn btn-primary btn-lg">Learn More About Us</a>
            </div>
        </div>
    </div>
</section>

<!-- Current Relief Projects Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold mb-3">CURRENT RELIEF PROJECTS</h2>
            <p class="lead text-muted">Making a difference in communities worldwide</p>
        </div>

        <div class="row g-4">
            <!-- Flood Relief -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 project-card">
                    <div class="card-img-top bg-primary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="bi bi-water" style="font-size: 4rem;"></i>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">Flood Relief</h5>
                        <p class="card-text">
                            Providing immediate assistance and emergency supplies to communities 
                            affected by devastating floods.
                        </p>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">75% Funded</small>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-center pb-3">
                        <a asp-action="ReliefProjects" class="btn btn-outline-primary">Learn More</a>
                    </div>
                </div>
            </div>

            <!-- Food Aid -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 project-card">
                    <div class="card-img-top bg-success text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="bi bi-basket" style="font-size: 4rem;"></i>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">Food Aid</h5>
                        <p class="card-text">
                            Ensuring families have access to nutritious meals and clean water 
                            in areas facing food insecurity.
                        </p>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 60%" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">60% Funded</small>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-center pb-3">
                        <a asp-action="ReliefProjects" class="btn btn-outline-success">Learn More</a>
                    </div>
                </div>
            </div>

            <!-- Emergency Response -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 project-card">
                    <div class="card-img-top bg-danger text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                        <i class="bi bi-hospital" style="font-size: 4rem;"></i>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">Emergency Medical Aid</h5>
                        <p class="card-text">
                            Delivering critical healthcare services and medical supplies 
                            to underserved and disaster-affected areas.
                        </p>
                        <div class="progress mb-3" style="height: 8px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: 85%" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">85% Funded</small>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-center pb-3">
                        <a asp-action="ReliefProjects" class="btn btn-outline-danger">Learn More</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a asp-action="ReliefProjects" class="btn btn-primary btn-lg px-5">View All Projects</a>
        </div>
    </div>
</section>

<!-- How You Can Help Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold mb-3">HOW YOU CAN HELP</h2>
            <p class="lead text-muted">Every contribution makes a difference</p>
        </div>

        <div class="row g-4">
            <!-- Donate -->
            <div class="col-md-4">
                <div class="text-center p-4 help-card">
                    <div class="mb-4">
                        <div class="icon-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center rounded-circle" 
                             style="width: 100px; height: 100px;">
                            <i class="bi bi-currency-dollar text-primary" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">DONATE</h3>
                    <p class="mb-4">
                        Your financial contribution helps us provide immediate relief and 
                        long-term support to communities in need.
                    </p>
                    <a asp-action="Donate" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-heart-fill me-2"></i> Make a Donation
                    </a>
                </div>
            </div>

            <!-- Volunteer -->
            <div class="col-md-4">
                <div class="text-center p-4 help-card">
                    <div class="mb-4">
                        <div class="icon-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center rounded-circle" 
                             style="width: 100px; height: 100px;">
                            <i class="bi bi-people-fill text-success" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">VOLUNTEER</h3>
                    <p class="mb-4">
                        Join our team of dedicated volunteers and use your skills 
                        to make a direct impact in communities.
                    </p>
                    <a asp-action="Volunteer" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-person-check-fill me-2"></i> Apply to Volunteer
                    </a>
                </div>
            </div>

            <!-- Support -->
            <div class="col-md-4">
                <div class="text-center p-4 help-card">
                    <div class="mb-4">
                        <div class="icon-circle bg-info bg-opacity-10 d-inline-flex align-items-center justify-content-center rounded-circle" 
                             style="width: 100px; height: 100px;">
                            <i class="bi bi-megaphone-fill text-info" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-3">SUPPORT</h3>
                    <p class="mb-4">
                        Spread awareness about our mission and help us reach more 
                        people who need assistance.
                    </p>
                    <a asp-action="Contact" class="btn btn-info btn-lg w-100">
                        <i class="bi bi-envelope-fill me-2"></i> Get in Touch
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics/Impact Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3">
                <div class="display-4 fw-bold mb-2">1000+</div>
                <div class="fs-5">Projects Completed</div>
            </div>
            <div class="col-md-3">
                <div class="display-4 fw-bold mb-2">50,000+</div>
                <div class="fs-5">Lives Impacted</div>
            </div>
            <div class="col-md-3">
                <div class="display-4 fw-bold mb-2">25+</div>
                <div class="fs-5">Countries Served</div>
            </div>
            <div class="col-md-3">
                <div class="display-4 fw-bold mb-2">5000+</div>
                <div class="fs-5">Active Volunteers</div>
            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-20px);
        }
        60% {
            transform: translateY(-10px);
        }
    }

    .project-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .project-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }

    .help-card {
        transition: transform 0.3s ease;
    }

    .help-card:hover {
        transform: scale(1.05);
    }

    .icon-circle {
        transition: transform 0.3s ease;
    }

    .help-card:hover .icon-circle {
        transform: rotate(360deg);
    }
</style>
