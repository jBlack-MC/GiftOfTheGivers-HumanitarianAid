@model GiftOfTheGivers.Models.ViewModels.DonateViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Donate";
    var paymentCancelled = ViewData["PaymentCancelled"] as bool? == true;
    var rateJson = System.Text.Json.JsonSerializer.Serialize(Model.RatesToZar);
}

<!-- Page Header -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">DONATE</h1>
        <p class="lead">Your generosity changes lives</p>
    </div>
</section>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-6 mx-auto">
            @if (paymentCancelled)
            {
                <div class="alert alert-warning" role="status">
                    <i class="bi bi-x-circle-fill me-2" aria-hidden="true"></i>
                    Your payment was cancelled and you were not charged. You can try again below.
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ProjectTitle))
            {
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                    <strong>Donating to:</strong> @Model.ProjectTitle
                </div>
            }

            <div class="card shadow-lg border-0">
                <div class="card-body p-4">
                    <h2 class="h3 text-center mb-4">How would you like to donate?</h2>

                    <form asp-action="Donate" method="post" id="donateForm" novalidate>
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="IdempotencyToken" />

                        <!-- Donation Type -->
                        <fieldset class="mb-4">
                            <legend class="form-label fw-bold fs-6">Donation type</legend>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" asp-for="DonationType" id="oneTime" value="OneTime">
                                <label class="form-check-label" for="oneTime">One-time donation</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="DonationType" id="recurring" value="Recurring">
                                <label class="form-check-label" for="recurring">Monthly pledge</label>
                            </div>
                            <div class="form-text">
                                A monthly pledge records your intention to give each month. Automatic monthly billing is not
                                yet available, so each payment is made separately.
                            </div>
                            <span asp-validation-for="DonationType" class="text-danger"></span>
                        </fieldset>

                        <!-- Project Selection -->
                        <div class="mb-4">
                            <label asp-for="ReliefProjectId" class="form-label fw-bold">Project</label>
                            <select asp-for="ReliefProjectId" class="form-select">
                                <option value="">General Donation - Where Most Needed</option>
                                @if (Model.AvailableProjects != null)
                                {
                                    foreach (var project in Model.AvailableProjects)
                                    {
                                        <option value="@project.Id">@project.Title - @project.Location</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ReliefProjectId" class="text-danger"></span>
                        </div>

                        <!-- Currency Selection -->
                        <div class="mb-3">
                            <label asp-for="Currency" class="form-label fw-bold">Currency</label>
                            <select asp-for="Currency" class="form-select" id="currency">
                                <option value="ZAR">ZAR (South African Rand)</option>
                                <option value="USD">USD (US Dollar)</option>
                                <option value="EUR">EUR (Euro)</option>
                            </select>
                            <span asp-validation-for="Currency" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text" id="currencySymbol">@Money.Symbol(Model.Currency)</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="1" max="@DonateViewModel.MaximumAmount"
                                       value="@(Model.Amount > 0 ? Model.Amount.ToString("0.00", CultureInfo.InvariantCulture) : "")"
                                       placeholder="500.00" aria-describedby="zarEquivalent" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                            <div id="zarEquivalent" class="form-text" aria-live="polite"></div>
                        </div>

                        <!-- Quick Amount Buttons -->
                        <div class="mb-4" role="group" aria-label="Quick amounts">
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-outline-secondary flex-fill quick-amount" data-amount="100">100</button>
                                <button type="button" class="btn btn-outline-secondary flex-fill quick-amount" data-amount="500">500</button>
                                <button type="button" class="btn btn-outline-secondary flex-fill quick-amount" data-amount="1000">1000</button>
                                <button type="button" class="btn btn-outline-secondary flex-fill quick-amount" data-amount="5000">5000</button>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Your Details -->
                        <h3 class="h5 mb-3">Your details</h3>

                        <div class="mb-3">
                            <label asp-for="DonorName" class="form-label">Name</label>
                            <input asp-for="DonorName" class="form-control" autocomplete="name" placeholder="Enter your name" />
                            <span asp-validation-for="DonorName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DonorEmail" class="form-label">Email</label>
                            <input asp-for="DonorEmail" class="form-control" type="email" autocomplete="email" placeholder="your.email@example.com" />
                            <span asp-validation-for="DonorEmail" class="text-danger"></span>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label">Preferred payment method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="Card">Credit/Debit Card</option>
                                <option value="EFT">Instant EFT</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <!-- Anonymous Donation -->
                        <div class="mb-3 form-check">
                            <input asp-for="IsAnonymous" class="form-check-input" type="checkbox" />
                            <label asp-for="IsAnonymous" class="form-check-label">Make donation anonymous</label>
                            <div class="form-text">Your name is hidden on certificates and staff reports. We still keep your email for your receipt.</div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Add a personal message..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Privacy consent -->
                        <div class="mb-4 form-check">
                            <input asp-for="PrivacyConsent" class="form-check-input" type="checkbox" />
                            <label asp-for="PrivacyConsent" class="form-check-label">
                                I have read the <a asp-action="Privacy" target="_blank" rel="noopener">privacy notice</a> and agree to my details being used to process this donation.
                            </label>
                            <span asp-validation-for="PrivacyConsent" class="text-danger d-block"></span>
                        </div>

                        <div class="alert @(Model.PaymentsSandbox ? "alert-warning" : "alert-info")">
                            <small>
                                <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
                                @if (!Model.PaymentsEnabled)
                                {
                                    <span><strong>Payments are switched off on this site.</strong> Your donation will be recorded as awaiting payment and will not be charged.</span>
                                }
                                else if (Model.PaymentsSandbox)
                                {
                                    <span><strong>Test mode:</strong> you will be sent to the PayFast <em>sandbox</em>. No real money is taken.</span>
                                }
                                else
                                {
                                    <span>You will be sent to PayFast to pay securely. We never see your card details.</span>
                                }
                                PayFast charges in rand; foreign-currency amounts are converted at the rate shown.
                            </small>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-heart-fill me-2" aria-hidden="true"></i>@(Model.PaymentsEnabled ? "CONTINUE TO PAYMENT" : "RECORD DONATION")
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tax Certificate Info -->
            <div class="card mt-4 border-success">
                <div class="card-body">
                    <h2 class="h6 card-title text-success">
                        <i class="bi bi-file-earmark-check-fill me-2" aria-hidden="true"></i>Tax Certificate
                    </h2>
                    <p class="card-text small mb-0">
                        Once PayFast confirms your payment, a donation certificate becomes available in your donor
                        dashboard. Sign in (or register) with the same email before donating so the donation is linked
                        to your account.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const currencySymbols = { ZAR: 'R', USD: '$', EUR: '€' };
            const ratesToZar = @Html.Raw(rateJson);
            const currency = document.getElementById('currency');
            const amount = document.getElementById('Amount');
            const equivalent = document.getElementById('zarEquivalent');

            function refresh() {
                const symbol = currencySymbols[currency.value] || '';
                document.getElementById('currencySymbol').textContent = symbol;
                document.querySelectorAll('.quick-amount').forEach(btn => {
                    btn.textContent = symbol + ' ' + btn.getAttribute('data-amount');
                });
                const value = parseFloat(amount.value);
                const rate = ratesToZar[currency.value];
                if (currency.value !== 'ZAR' && rate && value > 0) {
                    equivalent.textContent = 'Charged as approximately R ' + (value * rate).toFixed(2) +
                        ' (1 ' + currency.value + ' = R ' + rate + ', indicative rate).';
                } else {
                    equivalent.textContent = '';
                }
            }

            currency.addEventListener('change', refresh);
            amount.addEventListener('input', refresh);
            document.querySelectorAll('.quick-amount').forEach(button => {
                button.addEventListener('click', function () {
                    amount.value = this.getAttribute('data-amount');
                    document.querySelectorAll('.quick-amount').forEach(btn => btn.setAttribute('aria-pressed', 'false'));
                    this.setAttribute('aria-pressed', 'true');
                    refresh();
                });
            });
            refresh();
        })();
    </script>
}
