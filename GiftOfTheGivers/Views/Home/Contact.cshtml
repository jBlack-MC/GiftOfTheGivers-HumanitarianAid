@model GiftOfTheGivers.Models.ViewModels.ContactViewModel
@inject Microsoft.Extensions.Options.IOptions<GiftOfTheGivers.Services.OrganisationOptions> OrganisationOptions

@{
    ViewData["Title"] = "Contact";
    var organisation = OrganisationOptions.Value;
}

<!-- Page Header -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">CONTACT US</h1>
        <p class="lead">We're here to help. Reach out anytime.</p>
    </div>
</section>

<div class="container my-5">
    <div class="row">
        <!-- Contact Info -->
        <div class="col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-envelope-fill text-primary" style="font-size: 3rem;" aria-hidden="true"></i>
                    <h5 class="mt-3 mb-2">Email</h5>
                    <p class="text-muted mb-0"><a href="mailto:@organisation.ContactEmail">@organisation.ContactEmail</a></p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-telephone-fill text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 mb-2">Phone</h5>
                    <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(organisation.ContactPhone) ? "Use the form below" : organisation.ContactPhone)</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-geo-alt-fill text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 mb-2">Location</h5>
                    <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(organisation.Address) ? "South Africa" : organisation.Address)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Contact Form -->
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-body p-5">
                    <h3 class="mb-4">Send Us a Message</h3>
                    <form asp-action="Contact" method="post" novalidate>
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        <!-- Name -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Your full name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="your.email@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Subject -->
                        <div class="mb-4">
                            <label asp-for="Subject" class="form-label fw-bold"></label>
                            <input asp-for="Subject" class="form-control form-control-lg" placeholder="What is this about?" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <!-- Message -->
                        <div class="mb-4">
                            <label asp-for="Message" class="form-label fw-bold"></label>
                            <textarea asp-for="Message" class="form-control" rows="6" placeholder="Tell us how we can help..."></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="PrivacyConsent" class="form-check-input" type="checkbox" />
                            <label asp-for="PrivacyConsent" class="form-check-label">
                                I have read the <a asp-action="Privacy" target="_blank" rel="noopener">privacy notice</a> and agree to my details being used to answer this message.
                            </label>
                            <span asp-validation-for="PrivacyConsent" class="text-danger d-block"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send-fill me-2"></i>Send Message
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
