@model IEnumerable<GiftOfTheGivers.Models.ReliefProject>

@{
    ViewData["Title"] = "Relief Projects";
}

<!-- Page Header -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">RELIEF PROJECTS</h1>
        <p class="lead">Making a difference in communities that need it most</p>
    </div>
</section>

<section class="py-4 bg-light border-bottom">
    <div class="container">
        <div class="text-end">
            <span class="text-muted">
                <strong>@(Model?.Count() ?? 0)</strong> Active Projects
            </span>
        </div>
    </div>
</section>

<!-- Projects Grid Section -->
<section class="py-5">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden">
                            @if (!string.IsNullOrEmpty(project.ImageUrl))
                            {
                                <img src="@project.ImageUrl" class="card-img-top" alt="@project.Title" style="height: 220px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top d-flex align-items-center justify-content-center text-white"
                                     style="height: 220px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <i class="bi bi-image" style="font-size: 3rem; opacity: 0.5;"></i>
                                </div>
                            }
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0">@project.Title</h5>
                                    <span class="badge bg-@(project.Status == "Active" ? "success" : project.Status == "Completed" ? "primary" : "secondary")">
                                        @project.Status
                                    </span>
                                </div>
                                <p class="text-muted mb-3">
                                    <i class="bi bi-geo-alt-fill text-primary"></i> @project.Location
                                </p>
                                <p class="card-text text-muted mb-3">
                                    @(project.Description.Length > 120 ? project.Description.Substring(0, 120) + "..." : project.Description)
                                </p>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <small class="text-muted">Progress</small>
                                        <small class="text-muted">
                                            @{
                                                var percentage = project.FundsRequired > 0
                                                    ? (int)((project.FundsRaised / project.FundsRequired) * 100)
                                                    : 0;
                                                percentage = Math.Min(percentage, 100);
                                            }
                                            <strong>@percentage%</strong>
                                        </small>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-@(percentage >= 75 ? "success" : percentage >= 50 ? "info" : "warning")"
                                             role="progressbar"
                                             style="width: @percentage%"
                                             aria-valuenow="@percentage"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <small class="text-muted">
                                        @project.FundsRaised.ToString("C0") raised of @project.FundsRequired.ToString("C0") goal
                                    </small>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-grid px-3 pb-3">
                                <a asp-action="Donate" asp-route-projectId="@project.Id" class="btn btn-primary">
                                    <i class="bi bi-heart-fill me-2"></i>Donate to Project
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard-x text-muted" style="font-size: 4rem;"></i>
                <h3 class="mt-3">No relief projects yet</h3>
                <p class="text-muted">Check back soon, or reach out to see how you can help.</p>
                <a asp-action="Contact" class="btn btn-outline-primary mt-2">Contact Us</a>
            </div>
        }
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="display-5 fw-bold mb-3">Can't Find What You're Looking For?</h2>
        <p class="lead text-muted mb-4">
            You can make a general donation to support all our relief efforts, or contact us to learn more about specific projects.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-action="Donate" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-heart-fill me-2"></i>Make General Donation
            </a>
            <a asp-action="Contact" class="btn btn-outline-primary btn-lg px-5">
                <i class="bi bi-envelope-fill me-2"></i>Contact Us
            </a>
        </div>
    </div>
</section>

<style>
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }
</style>
