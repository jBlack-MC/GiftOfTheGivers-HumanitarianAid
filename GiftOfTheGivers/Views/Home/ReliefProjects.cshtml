                            <i class="bi bi-water" style="font-size: 4rem;"></i>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">Flood Relief</h5>
                                <span class="badge bg-success">Active</span>
                            </div>
                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt-fill text-primary"></i> Johannesburg
                            </p>
                            <p class="text-muted small mb-2">
                                <span class="badge bg-light text-primary border">Disaster Relief</span>
                            </p>
                            <p class="card-text text-muted mb-3">
