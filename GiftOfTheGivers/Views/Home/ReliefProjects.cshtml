@model IEnumerable<GiftOfTheGivers.Models.ReliefProject>

@{
    ViewData["Title"] = "Relief Projects";
}

<!-- Page Header -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">RELIEF PROJECTS</h1>
        <p class="lead">Making a difference in communities that need it most</p>
    </div>
</section>

<!-- Filter Section -->
<section class="py-4 bg-light border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="btn-group flex-wrap" role="group" aria-label="Project categories">
                    <button type="button" class="btn btn-outline-primary active" data-filter="all">
                        <i class="bi bi-grid-fill me-2"></i>All Projects
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-filter="disaster-relief">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Disaster Relief
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-filter="food-assistance">
                        <i class="bi bi-basket-fill me-2"></i>Food Assistance
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-filter="medical-assistance">
                        <i class="bi bi-hospital-fill me-2"></i>Medical Assistance
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-filter="community-support">
                        <i class="bi bi-people-fill me-2"></i>Community Support
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-filter="emergency-response">
                        <i class="bi bi-lightning-fill me-2"></i>Emergency Response
                    </button>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="text-muted">
                    <strong id="project-count">12</strong> Active Projects
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Projects Grid Section -->
<section class="py-5">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <!-- Display actual projects from database -->
            <div class="row g-4" id="projects-grid">
                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4 project-card" data-category="custom">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden">
                            @if (!string.IsNullOrEmpty(project.ImageUrl))
                            {
                                <img src="@project.ImageUrl" class="card-img-top" alt="@project.Title" style="height: 220px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-gradient d-flex align-items-center justify-content-center text-white" 
                                     style="height: 220px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <i class="bi bi-image" style="font-size: 3rem; opacity: 0.5;"></i>
                                </div>
                            }
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0">@project.Title</h5>
                                    <span class="badge bg-@(project.Status == "Active" ? "success" : project.Status == "Completed" ? "primary" : "secondary")">
                                        @project.Status
                                    </span>
                                </div>
                                <p class="text-muted mb-3">
                                    <i class="bi bi-geo-alt-fill text-primary"></i> @project.Location
                                </p>
                                <p class="card-text text-muted mb-3">
                                    @(project.Description.Length > 120 ? project.Description.Substring(0, 120) + "..." : project.Description)
                                </p>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <small class="text-muted">Progress</small>
                                        <small class="text-muted">
                                            @{
                                                var percentage = project.FundsRequired > 0 
                                                    ? (int)((project.FundsRaised / project.FundsRequired) * 100) 
                                                    : 0;
                                                percentage = Math.Min(percentage, 100);
                                            }
                                            <strong>@percentage%</strong>
                                        </small>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-@(percentage >= 75 ? "success" : percentage >= 50 ? "info" : "warning")" 
                                             role="progressbar" 
                                             style="width: @percentage%" 
                                             aria-valuenow="@percentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                    <small class="text-muted">
                                        @project.FundsRaised.ToString("C0") raised of @project.FundsRequired.ToString("C0") goal
                                    </small>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 d-grid px-3 pb-3">
                                <a asp-action="Donate" asp-route-projectId="@project.Id" class="btn btn-primary">
                                    <i class="bi bi-heart-fill me-2"></i>Donate to Project
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
