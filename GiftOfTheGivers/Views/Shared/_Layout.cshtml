<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <script>
      // Show the cinematic intro once per browser session, only when landing
      // on the homepage itself (not on deep links to other pages). The intro
      // page marks itself seen (via ?auto=1) and redirects back here when done.
      (function () {
        try {
          if (sessionStorage.getItem("gotg-intro-seen")) return;
          var p = location.pathname.replace(/\/+$/, "").toLowerCase() || "/";
          if (p === "" || p === "/" || p === "/home" || p === "/home/index") {
            location.replace("/intro/index.html?auto=1");
          }
        } catch (e) {}
      })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGivers.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.svg" alt="" class="navbar-logo" /> Gift of the Givers
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Public Navigation -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="ReliefProjects">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Volunteer">Volunteer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>

                        @if (User.IsInRole("Donor"))
                        {
                            <!-- Donor Navigation -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="donorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Donor Portal
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="donorDropdown">
                                    <li><a class="dropdown-item" asp-controller="Donor" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Donor" asp-action="MyDonations">My Donations</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Donate">Make Donation</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Employee"))
                        {
                            <!-- Employee Navigation -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="employeeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Employee Portal
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="employeeDropdown">
                                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="Dashboard">Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="ReliefProjects">Manage Projects</a></li>
                                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="Volunteers">Manage Volunteers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="Donations">View Donations</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Donate Button & Login -->
                    <div class="d-flex align-items-center">
                        <a asp-controller="Home" asp-action="Donate" class="btn btn-donate btn-sm me-3">
                            <i class="bi bi-heart-fill me-1"></i> Donate Now
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <h5 class="d-flex align-items-center gap-2"><img src="~/img/logo-light.svg" alt="" class="navbar-logo" /> Gift of the Givers</h5>
                    <p class="small mb-0">Bringing hope and relief to those in need.</p>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <h6 class="text-uppercase small mb-3" style="letter-spacing:.05em;">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="About" class="text-muted">About Us</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="ReliefProjects" class="text-muted">Our Projects</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Volunteer" class="text-muted">Volunteer</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-muted">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase small mb-3" style="letter-spacing:.05em;">Contact Information</h6>
                    <p class="small mb-0">
                        <i class="bi bi-envelope-fill me-2"></i>info@giftofthegivers.org<br>
                        <i class="bi bi-telephone-fill me-2"></i>+27 (0) 12 345 6789<br>
                        <i class="bi bi-geo-alt-fill me-2"></i>123 Main Street, Cape Town
                    </p>
                </div>
            </div>
            <hr>
            <div class="text-center small">
                &copy; 2026 - Gift of the Givers - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
