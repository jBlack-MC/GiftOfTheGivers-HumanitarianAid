@model GiftOfTheGivers.Models.Donation
@inject Microsoft.Extensions.Options.IOptions<GiftOfTheGivers.Services.OrganisationOptions> OrganisationOptions

@{
    ViewData["Title"] = "Tax Certificate";
    var organisation = OrganisationOptions.Value;
    var donorName = GiftOfTheGivers.Services.TaxCertificatePdf.DonorDisplayName(Model);
    var reference = TaxCertificateNumber.Format(Model.TransactionReference, Model.Id);
    var isOwner = Model.DonorId != null && Model.DonorId == User.UserId();
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">

            <div class="card border-3 shadow-lg" style="border-color: var(--brand-primary);" id="certificate">
                <div class="card-body p-5">

                    <div class="text-center mb-4 pb-3 border-bottom">
                        <h1 class="display-5 fw-bold mb-2">@organisation.Name.ToUpperInvariant()</h1>
                        <h2 class="h3 text-primary mt-3">SECTION 18A DONATION CERTIFICATE</h2>
                    </div>

                    <dl class="my-5">
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">Donor</dt>
                            <dd class="col-7 fw-bold mb-0">@donorName</dd>
                        </div>
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">Donation</dt>
                            <dd class="col-7 fw-bold text-success fs-5 mb-0">@Money.Format(Model.Amount, Model.Currency)</dd>
                        </div>
                        @if (Model.Currency != "ZAR")
                        {
                            <div class="row mb-3">
                                <dt class="col-5 text-muted fw-normal">Rand value</dt>
                                <dd class="col-7 fw-bold mb-0">@Money.Zar(Model.AmountZar)</dd>
                            </div>
                        }
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">Date received</dt>
                            <dd class="col-7 fw-bold mb-0">@((Model.PaymentVerifiedAt ?? Model.DonationDate).ToString("dd MMMM yyyy"))</dd>
                        </div>
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">Certificate number</dt>
                            <dd class="col-7 mb-0"><code class="bg-light px-2 py-1 rounded fw-bold">@reference</code></dd>
                        </div>
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">Allocated to</dt>
                            <dd class="col-7 fw-bold mb-0">@(Model.ReliefProject?.Title ?? "General Fund")</dd>
                        </div>
                        <div class="row mb-3">
                            <dt class="col-5 text-muted fw-normal">PBO reference</dt>
                            <dd class="col-7 fw-bold mb-0">@(string.IsNullOrWhiteSpace(organisation.PboReference) ? "Not configured" : organisation.PboReference)</dd>
                        </div>
                    </dl>

                    @if (!organisation.CertificatesAreOfficial)
                    {
                        <div class="text-center my-4 py-3 bg-light rounded">
                            <p class="mb-0 fw-bold text-uppercase text-muted">Demonstration certificate</p>
                            <small class="text-muted">Not valid for tax purposes until the organisation's PBO details are configured.</small>
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <button type="button" onclick="window.print()" class="btn btn-primary btn-lg">
                            <i class="bi bi-printer-fill me-2" aria-hidden="true"></i>Print
                        </button>
                        <a asp-controller="Donor" asp-action="DownloadTaxCertificate" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-download me-2" aria-hidden="true"></i>Download PDF
                        </a>
                    </div>

                    <div class="text-center mt-4 pt-3 border-top">
                        <small class="text-muted">
                            @organisation.Name
                            @if (organisation.CertificatesAreOfficial)
                            {
                                <span> · Issued in terms of section 18A of the Income Tax Act</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 justify-content-center">
                @if (isOwner)
                {
                    <a asp-controller="Donor" asp-action="DonationDetails" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to Details
                    </a>
                    <a asp-controller="Donor" asp-action="MyDonations" class="btn btn-outline-secondary">
                        <i class="bi bi-list-ul me-2" aria-hidden="true"></i>All Donations
                    </a>
                }
                else
                {
                    <a asp-controller="Employee" asp-action="Donations" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to Donations
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        @@media print {
            body * {
                visibility: hidden;
            }
            #certificate, #certificate * {
                visibility: visible;
            }
            #certificate {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .btn, nav, footer {
                display: none !important;
            }
        }
    </style>
}
