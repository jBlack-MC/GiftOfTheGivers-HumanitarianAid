@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donation Details";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="display-4 mb-4">Donation Details</h1>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Transaction Information</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Transaction Reference:</strong>
                        </div>
                        <div class="col-sm-8">
                            <span class="font-monospace">@Model.TransactionReference</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Donation Date:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.DonationDate.ToString("dddd, dd MMMM yyyy HH:mm") UTC
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Amount:</strong>
                        </div>
                        <div class="col-sm-8">
                            <span class="fs-4 fw-bold text-success">@Money.Format(Model.Amount, Model.Currency)</span>
                            @if (Model.Currency != "ZAR")
                            {
                                <div class="small text-muted">@Money.Zar(Model.AmountZar) at R @Model.ExchangeRateToZar.ToString("0.####") per @Model.Currency</div>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Payment Status:</strong>
                        </div>
                        <div class="col-sm-8">
                            <partial name="_PaymentStatusBadge" model="Model.PaymentStatus" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Payment Method:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Model.PaymentMethod
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Project:</strong>
                        </div>
                        <div class="col-sm-8">
                            @if (Model.ReliefProject != null)
                            {
                                <div>
                                    <strong>@Model.ReliefProject.Title</strong><br>
                                    <small class="text-muted">@Model.ReliefProject.Location</small>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">General Donation (Any Project)</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Notes:</strong>
                            </div>
                            <div class="col-sm-8">
                                @Model.Notes
                            </div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Anonymous:</strong>
                        </div>
                        <div class="col-sm-8">
                            @(Model.IsAnonymous ? "Yes" : "No")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Tax Certificate:</strong>
                        </div>
                        <div class="col-sm-8">
                            @if (Model.PaymentStatus == PaymentStatus.Verified)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Available once payment is confirmed</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="MyDonations" class="btn btn-secondary">Back to My Donations</a>
                        @if (Model.PaymentStatus == PaymentStatus.Verified)
                        {
                            <a asp-action="TaxCertificate" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> View Tax Certificate
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4">
                <h5 class="alert-heading">Thank You!</h5>
                <p class="mb-0">
                    Your generous donation of <strong>@Money.Format(Model.Amount, Model.Currency)</strong> helps us continue our mission 
                    of providing relief and hope to communities in need.
                </p>
            </div>
        </div>
    </div>
</div>
