@model IEnumerable<GiftOfTheGivers.Models.Donation>

@{
    ViewData["Title"] = "My Donations";
}

<div class="container my-5">
    <h1 class="display-4 mb-4">My Donations</h1>
    <p class="lead">View your complete donation history and download tax certificates.</p>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Project</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var donation in Model)
                            {
                                <tr>
                                    <td>@donation.DonationDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (donation.ReliefProject != null)
                                        {
                                            <span>@donation.ReliefProject.Title</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">General Donation</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@Money.Format(donation.Amount, donation.Currency)</td>
                                    <td>@donation.PaymentMethod</td>
                                    <td>
                                        <small class="font-monospace">@donation.TransactionReference</small>
                                    </td>
                                    <td>
                                        <partial name="_PaymentStatusBadge" model="donation.PaymentStatus" />
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="DonationDetails" asp-route-id="@donation.Id" 
                                               class="btn btn-sm btn-primary" title="View Details">
                                                <i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">View details</span>
                                            </a>
                                            @if (donation.PaymentStatus == PaymentStatus.Verified)
                                            {
                                                <a asp-action="TaxCertificate" asp-route-id="@donation.Id"
                                                   class="btn btn-sm btn-success" title="Tax Certificate" aria-label="Tax certificate">
                                                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <td colspan="2" class="text-end"><strong>Total:</strong></td>
                                <td colspan="5"><strong>@Money.Zar(Model.Where(d => d.PaymentStatus == PaymentStatus.Verified).Sum(d => d.AmountZar))</strong> <small class="text-muted">confirmed, in rand</small></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Donations Yet</h4>
            <p>You haven't made any donations yet. Make a difference today!</p>
            <hr>
            <a asp-controller="Home" asp-action="Donate" class="btn btn-primary">Make a Donation</a>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
