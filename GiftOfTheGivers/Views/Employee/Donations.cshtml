@model IEnumerable<GiftOfTheGivers.Models.Donation>

@{
    ViewData["Title"] = "Manage Donations";
}

<div class="container my-5">
    <h1 class="display-4 mb-4">Donations Management</h1>
    <p class="lead">View and manage all donations received.</p>

    @if (Model.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <h3>@Model.Count()</h3>
                        <p class="text-muted">Total Donations</p>
                    </div>
                    <div class="col-md-4">
                        <h3>@Model.Sum(d => d.Amount).ToString("C")</h3>
                        <p class="text-muted">Total Amount</p>
                    </div>
                    <div class="col-md-4">
                        <h3>@Model.Average(d => d.Amount).ToString("C")</h3>
                        <p class="text-muted">Average Donation</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Donor</th>
                                <th>Project</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Reference</th>
                                <th>Tax Cert</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var donation in Model)
                            {
                                <tr>
                                    <td>@donation.DonationDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (donation.IsAnonymous)
                                        {
                                            <span class="text-muted">Anonymous</span>
                                        }
                                        else
                                        {
                                            <span>@(donation.Donor?.UserName ?? "N/A")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (donation.ReliefProject != null)
                                        {
                                            <span>@donation.ReliefProject.Title</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">General</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">@donation.Amount.ToString("C")</td>
                                    <td>@donation.PaymentMethod</td>
                                    <td>
                                        <small class="font-monospace">@donation.TransactionReference</small>
                                    </td>
                                    <td>
                                        @if (donation.TaxCertificateIssued)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">No</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                <td colspan="4"><strong>@Model.Sum(d => d.Amount).ToString("C")</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Donations Yet</h4>
            <p>No donations have been received yet.</p>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
