@model GiftOfTheGivers.Models.ViewModels.VolunteersPageViewModel

@{
    ViewData["Title"] = "Manage Volunteers";
    var filters = new (VolunteerStatus? Status, string Label, int Count)[]
    {
        (null, "All", Model.AllCount),
        (VolunteerStatus.Pending, "Pending", Model.PendingCount),
        (VolunteerStatus.Approved, "Approved", Model.ApprovedCount),
        (VolunteerStatus.Rejected, "Rejected", Model.RejectedCount)
    };
    var route = new Dictionary<string, string?> { ["status"] = Model.StatusFilter?.ToString() };
}

<div class="container my-5">
    <h1 class="display-4 mb-4">Volunteer Applications</h1>
    <p class="lead">Review and manage volunteer applications.</p>

    <ul class="nav nav-tabs mb-4" aria-label="Filter by status">
        @foreach (var (status, label, count) in filters)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.StatusFilter == status ? "active" : "")" asp-action="Volunteers" asp-route-status="@status"
                   aria-current="@(Model.StatusFilter == status ? "page" : null)">@label (@count)</a>
            </li>
        }
    </ul>

    <partial name="_VolunteerTable" model="Model.Volunteers.Items" />
    <partial name="_Pager" model="(Model.Volunteers.Page, Model.Volunteers.TotalPages, Model.Volunteers.TotalCount, (IDictionary<string, string?>)route)" />

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
