@model GiftOfTheGivers.Models.ViewModels.PagedList<GiftOfTheGivers.Models.Inquiry>
@{
    ViewData["Title"] = "Inquiries";
    var route = new Dictionary<string, string?>();
}

<div class="container my-5">
    <h1 class="mb-2">Contact inquiries</h1>
    <p class="text-muted">Open inquiries are listed first.</p>

    @if (Model.TotalCount == 0)
    {
        <div class="alert alert-info">No inquiries yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Submitted (UTC)</th>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Message</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inquiry in Model.Items)
                    {
                        <tr>
                            <td>@inquiry.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@inquiry.Name</td>
                            <td><a href="mailto:@inquiry.Email">@inquiry.Email</a></td>
                            <td>@inquiry.Subject</td>
                            <td style="max-width: 28rem; white-space: pre-wrap;">@inquiry.Message</td>
                            <td><span class="badge @(inquiry.Handled ? "bg-secondary" : "bg-info text-dark")">@(inquiry.Handled ? "Handled" : "Open")</span></td>
                            <td>
                                @if (!inquiry.Handled)
                                {
                                    <form asp-action="MarkInquiryHandled" method="post">
                                        <input type="hidden" name="id" value="@inquiry.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Mark handled</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.TotalCount, (IDictionary<string, string?>)route)" />
    }

    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>
