<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="giftgivers-helpers" value="https://pkgs.dev.azure.com/ST10438928/663d5a52-1332-4463-92cb-b12591f7fde0/_packaging/giftgivers-helpers/nuget/v3/index.json" />
  </packageSources>
  <!-- Vulnerability data comes from nuget.org only; the private feed needs credentials. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <!-- Source mapping: every package comes from nuget.org except our own Helpers package. This
       stops restore from querying the private feed (401 without credentials) and prevents
       dependency-confusion attacks where a public package shadows a private one or vice versa. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="giftgivers-helpers">
      <package pattern="GiftOfTheGivers.Helpers" />
    </packageSource>
  </packageSourceMapping>
</configuration>
